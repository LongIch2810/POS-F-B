NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://<db-user>:<db-password>@localhost:5432/<db-name>
BOOTSTRAP_ADMIN_USERNAME=<username>
BOOTSTRAP_ADMIN_FULL_NAME=<full-name>
BOOTSTRAP_ADMIN_PASSWORD=<password-at-least-12-characters>
PUBLIC_ORIGIN=http://localhost:5173
JWT_SECRET=<random-secret-at-least-32-bytes>
CSRF_SECRET=<different-random-secret-at-least-32-bytes>
